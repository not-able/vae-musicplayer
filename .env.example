# Metadata source for the catalog repository.
# local: use developer-maintained mock/static metadata.
# remote: future API-backed catalog.
VITE_CATALOG_SOURCE=local

# Reserved for a future backend API. Keep empty in the local MVP.
VITE_API_BASE_URL=

# Optional self-hosted QQ Music API metadata endpoint. Leave empty to keep the
# Provider disabled; users can also enter an address explicitly in the import dialog.
# Do not put a cookie, account token, audio URL, or a public default address here.
VITE_QQ_MUSIC_API_BASE_URL=

# Demo audio must only use self-made or properly licensed files.
VITE_ENABLE_AUTHORIZED_DEMO_AUDIO=false
